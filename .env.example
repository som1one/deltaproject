# =====================================================================
# Looney Moon · backend · environment variables
# =====================================================================
# Скопируйте файл в `.env` для локалки или подставьте значения в
# Railway → Service → Variables. Любую переменную можно опустить, если
# у поля в core/settings.py есть default — здесь перечислены те,
# которые нужны для прод-старта.

# ---- Окружение и логи -----------------------------------------------
APP_ENV=production            # development | staging | production
LOG_LEVEL=INFO

# ---- База данных -----------------------------------------------------
# Railway Postgres отдаёт URL вида postgresql://user:pass@host:port/db.
# Бэкенд сам нормализует его в postgresql+asyncpg://..., так что можно
# просто скопировать «как есть» из переменной DATABASE_URL у Postgres-сервиса.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/app

# ---- JWT и refresh-токены -------------------------------------------
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_long_random_string
REFRESH_TOKEN_SECRET_KEY=change_me_other_long_random_string
JWT_EXPIRATION_TIME=3600
REFRESH_TOKEN_EXPIRATION_TIME=86400

# ---- Карты выплат ----------------------------------------------------
# Соль (pepper) для SHA-256 отпечатка карты — PAN в БД не хранится.
# ОБЯЗАТЕЛЬНА для функции выплат: если переменная не задана (пустая),
# сохранение карты выплаты отклоняется с HTTP 503 (ошибка конфигурации,
# явно отличимая от успешного ответа). Карты сохранять будет нельзя,
# пока секрет не сконфигурирован.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Не коммитьте реальное значение — задавайте его в .env / Railway Variables.
PAYOUT_CARD_PEPPER=change_me_pepper

# ---- Карта приёма платежей (эскроу) ---------------------------------
# Ключ Fernet для шифрования полного номера Карты_Приёма при хранении.
# В отличие от карты выплаты, номер карты приёма предъявляется плательщику
# целиком, поэтому хранится зашифрованным (а не только хеш). Если переменная
# не задана (пустая), сохранение/чтение полного PAN отклоняется с HTTP 503
# (паттерн как у PAYOUT_CARD_PEPPER).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Не коммитьте реальное значение — задавайте его в .env / Railway Variables.
COLLECTION_CARD_ENC_KEY=change_me_fernet_key

# ---- CORS ------------------------------------------------------------
# Список доменов фронта через запятую. Локалхост разрешается всегда.
ALLOWED_ORIGINS=https://your-frontend.up.railway.app

# ---- Telegram OAuth (если нужен) ------------------------------------
TELEGRAM_OAUTH_ENABLED=false
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
TELEGRAM_OAUTH_BOT_USERNAME=
TELEGRAM_OAUTH_BOT_TOKEN=
# Где Telegram возвращает code. ДОЛЖЕН байт-в-байт совпадать с Allowed redirect_uri
# в BotFather. Через nginx запрос к API идёт с префиксом /api, поэтому:
#   http://<host>/api/auth/telegram/callback
TELEGRAM_OAUTH_REDIRECT_URI=
TELEGRAM_OAUTH_FRONTEND_CALLBACK_URL=
# SOCKS5-прокси для обхода блокировки oauth.telegram.org (РКН), напр. socks5://127.0.0.1:40000
TELEGRAM_OAUTH_PROXY=

# ---- Маркетплейс блогеров --------------------------------------------
# Базовый URL фронтенда маркетплейса для генерации реферальных ссылок.
MARKETPLACE_FRONTEND_URL=http://localhost:3000

# ---- ЮKassa (если нужны выплаты) ------------------------------------
YUKASSA_PAYOUT_ENABLED=false
YUKASSA_PAYOUT_SHOP_ID=
YUKASSA_PAYOUT_SECRET_KEY=
YUKASSA_PAYOUT_GATEWAY_ID=
YUKASSA_WEBHOOK_SECRET=

# ---- Bootstrap единственного администратора при первом деплое --------
# Если оба заданы, scripts/railway_start.sh при каждом деплое
# гарантирует наличие/обновление одного админа с этими данными.
ADMIN_BOOTSTRAP_NAME=Admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_TELEGRAM=
