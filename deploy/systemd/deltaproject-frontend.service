[Unit]
Description=looney moon — Next.js frontend
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/deltaproject/frontend
EnvironmentFile=/opt/deltaproject/frontend/.env.local
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=on-failure
RestartSec=3
StandardOutput=append:/var/log/deltaproject/frontend.log
StandardError=append:/var/log/deltaproject/frontend.err.log

[Install]
WantedBy=multi-user.target
