[Unit]
Description=looney moon — FastAPI backend
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/deltaproject
EnvironmentFile=/opt/deltaproject/.env
ExecStart=/opt/deltaproject/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips '*'
Restart=on-failure
RestartSec=3
StandardOutput=append:/var/log/deltaproject/backend.log
StandardError=append:/var/log/deltaproject/backend.err.log

[Install]
WantedBy=multi-user.target
