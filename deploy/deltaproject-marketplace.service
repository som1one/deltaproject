[Unit]
Description=Delta Marketplace Frontend (Next.js)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/deltaproject/marketplace
Environment=NODE_ENV=production
Environment=PORT=3001
EnvironmentFile=-/root/deltaproject/marketplace/.env.local
ExecStart=/usr/bin/node /root/deltaproject/marketplace/node_modules/.bin/next start --port 3001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
